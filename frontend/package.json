    "@vkontakte/vk-bridge": "3.0.2",
    "@vkontakte/vk-mini-apps-router": "1.8.6",
    "@vkontakte/vkui": "8.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
