# Application
APP_ENV=development
APP_NAME=ИПМКН Старт
APP_DOMAIN=localhost
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000/api
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://ipmkn:ipmkn@db:5432/ipmkn
POSTGRES_DB=ipmkn
POSTGRES_USER=ipmkn
POSTGRES_PASSWORD=replace-with-a-strong-database-password
TIMEZONE=Europe/Moscow
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEV_AUTH_ENABLED=true
SESSION_TTL_SECONDS=86400
VK_LAUNCH_MAX_AGE_SECONDS=900

# VK: keep all secrets on backend.
VK_APP_ID=
VK_APP_SECRET=
VK_SERVICE_TOKEN=
VK_COMMUNITY_ID=
VK_COMMUNITY_TOKEN=
BOOTSTRAP_ADMIN_VK_IDS=
VK_NOTIFICATIONS_ENABLED=false

# 2GIS MapGL key is public by design. Restrict it to production domains in 2GIS.
VITE_DGIS_MAPGL_KEY=
DGIS_SEARCH_KEY=

# Tulsu public schedule adapter.
TULSU_SCHEDULE_BASE_URL=https://tulsu.ru
TULSU_TIMEOUT_SECONDS=8
TULSU_CACHE_TTL_SECONDS=900

# Notifications are opt-in and disabled until a real provider is configured.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_POLL_SECONDS=5

# The deterministic assistant works without an AI provider.
ASSISTANT_MODE=retrieval
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=8
AI_DAILY_BUDGET_LIMIT=

# Frontend non-secret configuration.
VITE_API_BASE_URL=/api
VITE_APP_NAME=ИПМКН Старт
