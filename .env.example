# Application
APP_ENV=production
APP_NAME=ИПМКН Старт
APP_DOMAIN=start.example.ru
ADMIN_APP_DOMAIN=admin-start.example.ru
APP_PUBLIC_URL=https://start.example.ru
ADMIN_APP_PUBLIC_URL=https://admin-start.example.ru
API_PUBLIC_URL=https://start.example.ru/api
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://ipmkn:ipmkn@db:5432/ipmkn
POSTGRES_DB=ipmkn
POSTGRES_USER=ipmkn
POSTGRES_PASSWORD=replace-with-a-strong-database-password
TIMEZONE=Europe/Moscow
ALLOWED_ORIGINS=https://start.example.ru,https://admin-start.example.ru
COOKIE_SECURE=true
COOKIE_SAMESITE=none
DEV_AUTH_ENABLED=false
SESSION_TTL_SECONDS=86400
VK_LAUNCH_MAX_AGE_SECONDS=900

# VK: keep all secrets on backend.
VK_APP_ID=
VK_APP_SECRET=
VK_ADMIN_APP_ID=
VK_ADMIN_APP_SECRET=
VK_SERVICE_TOKEN=
VK_COMMUNITY_ID=
VK_COMMUNITY_TOKEN=
BOOTSTRAP_ADMIN_VK_IDS=
VK_NOTIFICATIONS_ENABLED=false

# Browser map integrations are opt-in. The MapGL key is public by design:
# restrict it to the production Origin/Referer in 2GIS Platform Manager.
DGIS_ENABLED=true
VITE_DGIS_MAPGL_KEY=

# Tulsu public schedule adapter.
TULSU_SCHEDULE_BASE_URL=https://tulsu.ru
TULSU_TIMEOUT_SECONDS=45
TULSU_CACHE_TTL_SECONDS=900

# Notifications are opt-in and disabled until a real provider is configured.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_POLL_SECONDS=5

# The deterministic assistant works without an AI provider.
AI_ASSISTANT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=8
# Hard request budget; configure a monetary cap in OpenRouter as well.
OPENROUTER_DAILY_REQUEST_LIMIT=100
ASSISTANT_TOP_N=3
ASSISTANT_RATE_LIMIT_PER_MINUTE=30

# Frontend non-secret configuration.
VITE_API_BASE_URL=/api
VITE_APP_NAME=ИПМКН Старт
